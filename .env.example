# CHANGE ME TO .env.local AND FILL IN THE VALUES BEFORE RUNNING THE APPLICATION


# [REQUIRED]
# Tip4Serv API Configuration
TIP4SERV_API_KEY=your_api_key_here

# [ OPTIONAL ] : Everything below is optional
# This should be enabled if you want to handle custom identification directly from your site. (For simplier setups, you can leave this disabled and use the default Tip4Serv identification system)
HANDLE_CUSTOMER_IDENTIFICATION=false


# [Optional] : This should be enabled if you want to handle custom identification and that you identify your customers with discord
# Discord OAuth: create an app at https://discord.com/developers/applications, add the redirect URI below, then copy the Client ID and Client Secret
# Client ID is needed for both public and server-side usage; Client Secret stays server-side only
NEXT_PUBLIC_DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_ID=your_discord_client_id
DISCORD_CLIENT_SECRET=your_discord_client_secret
NEXT_PUBLIC_DISCORD_REDIRECT_URI=http://localhost:3000/api/oauth/discord/callback

# [Optional, required for website appeal submissions]
# Discord webhook that receives new Discord/Rust appeals from the website.
APPEALS_DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# [Optional] Cloudy Store entitlements (server only, never NEXT_PUBLIC_).
# Shared secret with the Cloudy bot (same value on Railway), at least 32 characters.
# Needed before any paid product can unlock Premium or Rust kits automatically.
CLOUDY_DASHBOARD_API_SECRET=
# Tip4Serv product IDs that unlock Cloudy Bot Premium, e.g. {"123":{"months":1},"124":{"kind":"subscription"}}
CLOUDY_PREMIUM_PRODUCTS=
# Direct checkout on the Bot plan page, e.g. {"product":"124","guildFieldId":"45","subscription":true}
CLOUDY_PREMIUM_CHECKOUT=
# Tip4Serv product IDs that deliver Rust Console kits, e.g. {"200":{"kit":"starter","server":"main"}}
# Leave empty until real-money kit sales are approved.
CLOUDY_RUST_KIT_PRODUCTS=
# Who may open /admin/deliveries (same format as CLOUDY_FINANCE_ADMINS, e.g. discord:123...)
CLOUDY_STAFF_ADMINS=
